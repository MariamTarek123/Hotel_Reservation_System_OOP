<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.RoomBrowsingController"
      alignment="CENTER"
      spacing="15"
      prefWidth="600"
      prefHeight="500"
      styleClass="root-container">

    <padding>
        <Insets top="20" bottom="20" left="30" right="30"/>
    </padding>

    <Text text="Available Rooms" styleClass="title-text"/>

    <ProgressIndicator fx:id="loadingIndicator" visible="false" prefWidth="50" prefHeight="50"/>

    <ListView fx:id="roomsListView" VBox.vgrow="ALWAYS" styleClass="input-field"/>

    <Label fx:id="messageLabel" text="" styleClass="error-label" wrapText="true"/>

    <HBox spacing="20" alignment="CENTER">
        <Button text="Book Selected Room" onAction="#handleBookRoom" styleClass="primary-button" prefWidth="200"/>
        <Button text="Back to Dashboard" onAction="#goBack" styleClass="secondary-button" prefWidth="200"/>
    </HBox>

</VBox>