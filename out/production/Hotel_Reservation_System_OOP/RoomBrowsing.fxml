<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.RoomBrowsingController"
            prefWidth="1200" prefHeight="800"
            style="-fx-background-color: #f5f5f5;">

    <!-- TOP HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #cc0000; -fx-padding: 10 20;">
            <Button text="&lt; Back" onAction="#goBack"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-family: 'Merriweather'; -fx-font-size: 16px; -fx-border-color: white; -fx-border-width: 1; -fx-border-radius: 4; -fx-padding: 5 15;"/>
            <Label text="Browse Available Rooms"
                   style="-fx-font-family: 'Merriweather'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>
        <VBox prefWidth="250" spacing="20" style="-fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 0 1 0 0; -fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <!-- Assuming filter icon represented as text or simple label -->
                <Label text="Filters" style="-fx-font-family: 'Merriweather'; -fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
            </HBox>

            <VBox spacing="5">
                <Label text="Room Type" style="-fx-font-family: 'Merriweather'; -fx-font-size: 14px; -fx-text-fill: #555555;"/>
                <ComboBox fx:id="roomTypeCombo" promptText="All Types" maxWidth="Infinity" styleClass="register-combo" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 4;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Price Range" style="-fx-font-family: 'Merriweather'; -fx-font-size: 14px; -fx-text-fill: #555555;"/>
                <ComboBox fx:id="priceRangeCombo" promptText="All Prices" maxWidth="Infinity" styleClass="register-combo" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 4;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Floor" style="-fx-font-family: 'Merriweather'; -fx-font-size: 14px; -fx-text-fill: #555555;"/>
                <ComboBox fx:id="floorCombo" promptText="All Floors" maxWidth="Infinity" styleClass="register-combo" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 4;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Label fx:id="messageLabel" text="" wrapText="true" style="-fx-text-fill: #cc0000; -fx-font-family: 'Merriweather'; -fx-font-size: 12px;"/>
            <Button text="Book Selected Room" onAction="#handleBookRoom"
                    maxWidth="Infinity"
                    style="-fx-background-color: #e68a8a; -fx-text-fill: white; -fx-font-family: 'Merriweather'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10; -fx-background-radius: 4;"/>
            <Button text="Cancel" onAction="#goBack"
                    maxWidth="Infinity"
                    style="-fx-background-color: white; -fx-text-fill: black; -fx-border-color: #cccccc; -fx-border-radius: 4; -fx-font-family: 'Merriweather'; -fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 10;"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox style="-fx-padding: 20;" spacing="20">
            <!-- Header for Main Content -->
            <HBox alignment="BOTTOM_LEFT">
                <VBox spacing="5">
                    <Label text="Available Rooms" style="-fx-font-family: 'Merriweather'; -fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;"/>
                    <Label fx:id="availableCountLabel" text="0 rooms available" style="-fx-font-family: 'Merriweather'; -fx-font-size: 14px; -fx-text-fill: #777777;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="10">
                    <Label text="Sort by:" style="-fx-font-family: 'Merriweather'; -fx-font-size: 14px; -fx-text-fill: #555555;"/>
                    <ComboBox fx:id="sortByCombo" promptText="Price: Low to High" styleClass="register-combo" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 4;"/>
                </HBox>
            </HBox>

            <Separator />

            <!-- Room Cards Area -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                <FlowPane fx:id="roomsFlowPane" hgap="20" vgap="20" style="-fx-padding: 10;"/>
            </ScrollPane>
        </VBox>
    </center>

    <!-- Footer line to match image? Image shows a bottom status bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 5 20; -fx-background-color: white; -fx-border-color: #e0e0e0; -fx-border-width: 1 0 0 0;">
            <Label fx:id="bottomStatusLabel" text="0 rooms available | No selection" style="-fx-font-family: 'Merriweather'; -fx-font-size: 12px; -fx-text-fill: #777777;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Transylvania Hotel Management System v1.0" style="-fx-font-family: 'Merriweather'; -fx-font-size: 12px; -fx-text-fill: #777777;"/>
        </HBox>
    </bottom>

</BorderPane>
