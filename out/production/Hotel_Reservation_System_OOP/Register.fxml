<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.RegisterController"
      alignment="CENTER"
      spacing="12"
      prefWidth="400"
      prefHeight="600"
      styleClass="root-container">

    <padding>
        <Insets top="30" bottom="30" left="40" right="40"/>
    </padding>

    <Text text="Create Account" styleClass="title-text"/>

    <VBox spacing="5">
        <Label text="Username"/>
        <TextField fx:id="usernameField" promptText="Min 3 characters" styleClass="input-field"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Password"/>
        <PasswordField fx:id="passwordField" promptText="Min 7 chars, letters + digits" styleClass="input-field"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Address"/>
        <TextField fx:id="addressField" promptText="Your address" styleClass="input-field"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Date of Birth"/>
        <DatePicker fx:id="dobPicker" styleClass="input-field" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Gender"/>
        <ComboBox fx:id="genderCombo" promptText="Select gender" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Room Preference"/>
        <ComboBox fx:id="preferenceCombo" promptText="Select room type" maxWidth="Infinity"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="error-label" text="" wrapText="true"/>

    <Button text="Register" onAction="#handleRegister" styleClass="primary-button" maxWidth="Infinity"/>

    <HBox alignment="CENTER" spacing="5">
        <Label text="Already have an account?"/>
        <Hyperlink text="Login here" onAction="#goToLogin"/>
    </HBox>

</VBox>