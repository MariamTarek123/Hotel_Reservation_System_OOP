<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.ChatController"
      spacing="10"
      prefWidth="400"
      prefHeight="500"
      styleClass="root-container">

    <padding>
        <Insets top="15" bottom="15" left="15" right="15"/>
    </padding>

    <Text fx:id="chatTitle" text="Live Chat" styleClass="title-text"/>
    <Label fx:id="statusLabel" text="Connecting..." style="-fx-text-fill: gray;"/>

    <TextArea fx:id="chatArea"
              editable="false"
              wrapText="true"
              VBox.vgrow="ALWAYS"
              styleClass="input-field"/>

    <HBox spacing="8">
        <TextField fx:id="messageField"
                   promptText="Type a message..."
                   HBox.hgrow="ALWAYS"
                   styleClass="input-field"
                   onAction="#handleSend"/>
        <Button text="Send" onAction="#handleSend" styleClass="primary-button"/>
    </HBox>

    <Button text="Close Chat" onAction="#handleClose"
            styleClass="secondary-button" maxWidth="Infinity"/>

</VBox>
