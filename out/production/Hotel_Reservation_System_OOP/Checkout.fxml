<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.CheckoutController"
      alignment="CENTER"
      spacing="15"
      prefWidth="400"
      prefHeight="500"
      styleClass="root-container">

    <padding>
        <Insets top="30" bottom="30" left="40" right="40"/>
    </padding>

    <Text text="Checkout &amp; Payment" styleClass="title-text"/>

    <VBox spacing="5" alignment="CENTER">
        <Label text="Reservation Amount Due" style="-fx-font-weight: bold;"/>
        <Label fx:id="balanceLabel" text="\$0.00" style="-fx-font-size: 24px; -fx-text-fill: #2c3e50;"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Amount to Pay"/>
        <TextField fx:id="amountField" promptText="Enter amount" styleClass="input-field"/>
    </VBox>

    <VBox spacing="5">
        <Label text="Payment Method"/>
        <ComboBox fx:id="paymentMethodCombo" promptText="Select method" maxWidth="Infinity" styleClass="input-field"/>
    </VBox>

    <Label fx:id="messageLabel" text="" wrapText="true" alignment="CENTER"/>

    <ProgressIndicator fx:id="paymentIndicator" visible="false" prefWidth="40" prefHeight="40"/>

    <Button fx:id="payButton" text="Pay Now" onAction="#handlePayment" styleClass="primary-button" maxWidth="Infinity"/>
    <Button text="Return to Dashboard" onAction="#goBack" styleClass="secondary-button" maxWidth="Infinity"/>

</VBox>