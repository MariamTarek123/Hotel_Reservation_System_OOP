<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.LoginController"
      prefWidth="900"
      prefHeight="600"
      styleClass="login-root-bg">

    <!-- Left Side: Image / Brand -->
    <StackPane HBox.hgrow="ALWAYS" styleClass="login-left-panel">
        <!-- Dark transparent overlay -->
        <Region style="-fx-background-color: rgba(0, 0, 0, 0.45);"/>
        <VBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="40" bottom="40" left="40" right="40"/>
            </padding>
            <Region VBox.vgrow="ALWAYS" />
            <Text text="TRANSYLVANIA" styleClass="transylvania-brand"/>
            <Text text="HOTEL &amp; RESORT" styleClass="transylvania-subbrand"/>
            <Region prefHeight="20"/>
            <Text text="Experience luxury in the heart of the Carpathian" styleClass="transylvania-desc"/>
            <Text text="Mountains. Where legend meets comfort." styleClass="transylvania-desc"/>
            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </StackPane>

    <!-- Right Side: Login Form -->
    <VBox alignment="CENTER" spacing="15" prefWidth="450" style="-fx-background-color: white;">
        <padding>
            <Insets top="40" bottom="40" left="60" right="60"/>
        </padding>

        <VBox alignment="CENTER" spacing="5">
            <Text text="Welcome Back" styleClass="welcome-text"/>
            <Text text="Sign in to your account" styleClass="sign-in-text"/>
        </VBox>

        <Region prefHeight="10"/>

        <VBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Username" styleClass="form-label"/>
            <TextField fx:id="usernameField" promptText="Enter your username" styleClass="login-input"/>
        </VBox>

        <VBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Password" styleClass="form-label"/>
            <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="login-input"/>
        </VBox>

        <Label fx:id="errorLabel" styleClass="error-label" text="" wrapText="true"/>

        <HBox spacing="15" alignment="CENTER" prefWidth="Infinity">
            <Button fx:id="loginButton" text="Login as Guest" onAction="#handleLogin" styleClass="btn-red-filled" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button fx:id="staffLoginButton" text="Login as Staff" onAction="#handleStaffLogin" styleClass="btn-red-outline" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>

        <Region prefHeight="10"/>

        <HBox alignment="CENTER" spacing="5">
            <Label text="Don't have an account?" styleClass="form-label-muted"/>
            <Hyperlink text="Register" onAction="#goToRegister" styleClass="link-red"/>
        </HBox>
    </VBox>

</HBox>
