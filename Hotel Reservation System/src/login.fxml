<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controllers.LoginController"
      alignment="CENTER"
      spacing="15"
      prefWidth="400"
      prefHeight="500"
      styleClass="root-container">

    <padding>
        <Insets top="40" bottom="40" left="40" right="40"/>
    </padding>

    <Text text="Hotel Reservation System" styleClass="title-text"/>
    <Text text="Login" styleClass="subtitle-text"/>

    <VBox spacing="8">
        <Label text="Username"/>
        <TextField fx:id="usernameField" promptText="Enter username" styleClass="input-field"/>
    </VBox>

    <VBox spacing="8">
        <Label text="Password"/>
        <PasswordField fx:id="passwordField" promptText="Enter password" styleClass="input-field"/>
    </VBox>

    <Label fx:id="errorLabel" styleClass="error-label" text="" wrapText="true"/>

    <Button fx:id="loginButton" text="Login" onAction="#handleLogin" styleClass="primary-button" maxWidth="Infinity"/>
    <Button fx:id="staffLoginButton" text="Login as Staff" onAction="#handleStaffLogin" styleClass="secondary-button" maxWidth="Infinity"/>

    <HBox alignment="CENTER" spacing="5">
        <Label text="Don't have an account?"/>
        <Hyperlink text="Register here" onAction="#goToRegister"/>
    </HBox>

</VBox>